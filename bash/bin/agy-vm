#!/usr/bin/env bash
#
# agy-vm: Launch or connect to a shared Multipass dev VM (agy-vm).
# Mounts the current directory into the VM, provisions key developer toolchains, refreshes
# Antigravity CLI (agy) auth on every run, and drops directly into the working directory.
#

set -euo pipefail

if ! command -v multipass >/dev/null 2>&1; then
  echo "multipass is not installed" >&2
  exit 1
fi

PROJECT_DIR="$(pwd)"
PROJECT_NAME="$(basename "$PROJECT_DIR")"
if [ -z "$PROJECT_NAME" ] || [ "$PROJECT_NAME" = "/" ]; then
  PROJECT_NAME="workspace"
fi

VM_NAME="${AGY_VM_NAME:-agy-vm}"
CPUS="${AGY_VM_CPUS:-4}"
MEM="${AGY_VM_MEM:-8G}"
DISK="${AGY_VM_DISK:-40G}"
IMAGE="${AGY_VM_IMAGE:-24.04}"

vm_exists() {
  multipass info "$VM_NAME" >/dev/null 2>&1
}

vm_status() {
  multipass info "$VM_NAME" --format csv 2>/dev/null | awk -F',' 'NR==2 {print $3}'
}

if ! vm_exists; then
  echo "Creating VM '$VM_NAME' (${CPUS} CPUs, ${MEM} RAM, ${DISK} Disk)..."
  echo "Launching instance..."

  cat << 'EOF' | multipass launch "$IMAGE" \
    --name "$VM_NAME" \
    --cpus "$CPUS" \
    --memory "$MEM" \
    --disk "$DISK" \
    --cloud-init -
#cloud-config
package_update: true
packages:
  - apt-transport-https
  - ca-certificates
  - curl
  - wget
  - gnupg
  - lsb-release
  - git
  - build-essential
  - jq
  - ripgrep
  - htop
  - tmux
  - unzip
  - tree
  - python3
  - python3-pip
  - python3-venv
  - python3-dev
  - pipx
  - ruby-full
  - ruby-dev
  - bundler
  - docker.io
  - docker-compose-v2
  - docker-buildx

groups:
  - docker

system_info:
  default_user:
    groups: [docker, sudo]

write_files:
  - path: /etc/profile.d/99-agy-vm.sh
    permissions: '0644'
    owner: root:root
    content: |
      export PATH="$HOME/.local/bin:$HOME/.bun/bin:$HOME/.rbenv/bin:$HOME/.rbenv/shims:$HOME/.cargo/bin:$PATH"

      if [ -d "$HOME/.rbenv" ]; then
        eval "$(rbenv init - bash 2>/dev/null || true)"
      fi

      if command -v mise >/dev/null 2>&1; then
        eval "$(mise activate bash 2>/dev/null || true)"
      fi

      if command -v fnm >/dev/null 2>&1; then
        eval "$(fnm env --use-on-cd 2>/dev/null || true)"
      fi

  - path: /usr/local/bin/provision-agy-vm.sh
    permissions: '0755'
    owner: root:root
    content: |
      #!/usr/bin/env bash
      set -euxo pipefail

      # 1. Docker daemon configuration & user access
      usermod -aG docker ubuntu
      systemctl enable --now docker

      # 2. HashiCorp Terraform
      install -m 0755 -d /usr/share/keyrings
      wget -O- https://apt.releases.hashicorp.com/gpg | gpg --dearmor --yes -o /usr/share/keyrings/hashicorp-archive-keyring.gpg
      echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" | tee /etc/apt/sources.list.d/hashicorp.list
      apt-get update -y
      apt-get install -y terraform

      # 3. tenv (Terraform / OpenTofu / Terragrunt version manager)
      ARCH="$(dpkg --print-architecture)"
      TENV_DEB_URL="$(curl -fsSL https://api.github.com/repos/tofuutils/tenv/releases/latest | grep -o "https://github.com/tofuutils/tenv/releases/download/[^\"]*_${ARCH}.deb" | head -n 1 || true)"
      if [ -n "$TENV_DEB_URL" ]; then
        curl -fsSL -o /tmp/tenv.deb "$TENV_DEB_URL"
        dpkg -i /tmp/tenv.deb || true
        rm -f /tmp/tenv.deb
      fi

      # 4. Node.js 22 LTS + npm + Corepack (yarn & pnpm)
      curl -fsSL https://deb.nodesource.com/setup_22.x | bash -
      apt-get install -y nodejs
      corepack enable || true
      npm install -g yarn pnpm || true

      # 5. Fast Node Manager (fnm)
      curl -fsSL https://fnm.vercel.app/install | bash -s -- --install-dir /usr/local/bin --skip-shell || true

      # 6. Astral uv (Python package & version manager)
      curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh || true

      # 7. mise (Universal runtime version manager)
      curl https://mise.run | env MISE_INSTALL_PATH=/usr/local/bin/mise sh || true

      # 8. Bun
      su - ubuntu -c "curl -fsSL https://bun.sh/install | bash" || true
      if [ -f /home/ubuntu/.bun/bin/bun ]; then
        ln -sf /home/ubuntu/.bun/bin/bun /usr/local/bin/bun
      fi

      # 9. rbenv & ruby-build
      if [ ! -d "/home/ubuntu/.rbenv" ]; then
        su - ubuntu -c "git clone https://github.com/rbenv/rbenv.git ~/.rbenv"
        su - ubuntu -c "git clone https://github.com/rbenv/ruby-build.git ~/.rbenv/plugins/ruby-build"
      fi

      # 10. Antigravity CLI (agy)
      su - ubuntu -c "curl -fsSL https://antigravity.google/cli/install.sh | bash" || true
      if [ -f /home/ubuntu/.local/bin/agy ]; then
        ln -sf /home/ubuntu/.local/bin/agy /usr/local/bin/agy
      fi

      # 11. Ensure environment source in user bashrc
      echo "[ -f /etc/profile.d/99-agy-vm.sh ] && source /etc/profile.d/99-agy-vm.sh" >> /home/ubuntu/.bashrc

runcmd:
  - /usr/local/bin/provision-agy-vm.sh
EOF

  echo "Waiting for provisioning to complete..."
  multipass exec "$VM_NAME" -- cloud-init status --wait
  echo "VM '$VM_NAME' ready."
else
  CURRENT_STATUS="$(vm_status)"
  if [ "$CURRENT_STATUS" != "Running" ]; then
    echo "Starting VM '$VM_NAME'..."
    multipass start "$VM_NAME"
  fi
fi

# Check if current directory is already mounted in the VM
MOUNT_TARGET=""
if command -v jq >/dev/null 2>&1; then
  MOUNT_TARGET="$(multipass info "$VM_NAME" --format json 2>/dev/null | jq -r --arg src "$PROJECT_DIR" '.info["'"$VM_NAME"'"]?.mounts // {} | to_entries[]? | select(.value.source_path == $src) | .key' 2>/dev/null | head -n 1 || true)"
fi

if [ -n "$MOUNT_TARGET" ]; then
  TARGET_DIR="$MOUNT_TARGET"
else
  TARGET_DIR="/home/ubuntu/$PROJECT_NAME"
  if command -v jq >/dev/null 2>&1; then
    COLLIDING_SRC="$(multipass info "$VM_NAME" --format json 2>/dev/null | jq -r --arg tgt "$TARGET_DIR" '.info["'"$VM_NAME"'"]?.mounts[$tgt]?.source_path // empty' 2>/dev/null || true)"
    if [ -n "$COLLIDING_SRC" ]; then
      PARENT_DIR="$(basename "$(dirname "$PROJECT_DIR")")"
      TARGET_DIR="/home/ubuntu/${PARENT_DIR}-${PROJECT_NAME}"
    fi
  elif multipass info "$VM_NAME" 2>/dev/null | grep -F " => $TARGET_DIR" >/dev/null 2>&1; then
    PARENT_DIR="$(basename "$(dirname "$PROJECT_DIR")")"
    TARGET_DIR="/home/ubuntu/${PARENT_DIR}-${PROJECT_NAME}"
  fi

  echo "Mounting '$PROJECT_DIR' -> '$VM_NAME:$TARGET_DIR'..."
  multipass exec "$VM_NAME" -- mkdir -p "$TARGET_DIR"
  multipass mount "$PROJECT_DIR" "$VM_NAME:$TARGET_DIR"
fi

# Refresh auth tokens and settings
multipass exec "$VM_NAME" -- mkdir -p /home/ubuntu/.gemini/antigravity-cli

HOST_AUTH_TOKEN="$HOME/.gemini/antigravity-cli/antigravity-oauth-token"
if [ -f "$HOST_AUTH_TOKEN" ]; then
  multipass transfer "$HOST_AUTH_TOKEN" "$VM_NAME:/home/ubuntu/.gemini/antigravity-cli/antigravity-oauth-token"
  multipass exec "$VM_NAME" -- chmod 600 /home/ubuntu/.gemini/antigravity-cli/antigravity-oauth-token
fi

HOST_SETTINGS="$HOME/.gemini/antigravity-cli/settings.json"
if [ -f "$HOST_SETTINGS" ]; then
  multipass transfer "$HOST_SETTINGS" "$VM_NAME:/home/ubuntu/.gemini/antigravity-cli/settings.json"
  multipass exec "$VM_NAME" -- chmod 600 /home/ubuntu/.gemini/antigravity-cli/settings.json
fi

HOST_OAUTH_CREDS="$HOME/.gemini/oauth_creds.json"
if [ -f "$HOST_OAUTH_CREDS" ]; then
  multipass transfer "$HOST_OAUTH_CREDS" "$VM_NAME:/home/ubuntu/.gemini/oauth_creds.json"
  multipass exec "$VM_NAME" -- chmod 600 /home/ubuntu/.gemini/oauth_creds.json
fi

multipass exec "$VM_NAME" -- chown -R ubuntu:ubuntu /home/ubuntu/.gemini

echo "Entering '$VM_NAME' in '$TARGET_DIR'..."
exec multipass exec "$VM_NAME" -- bash -c "cd '$TARGET_DIR' && exec bash -l"
