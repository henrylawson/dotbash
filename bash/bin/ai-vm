#!/usr/bin/env bash
#
# ai-vm: Launch or connect to a shared Multipass AI development VM (ai-vm).
# Mounts the current directory into the VM, provisions key developer toolchains,
# installs Antigravity CLI (agy), and drops directly into the working directory.
#

set -euo pipefail

if ! command -v multipass >/dev/null 2>&1; then
  echo "multipass is not installed" >&2
  exit 1
fi

PROJECT_DIR="$(pwd)"
PROJECT_NAME="$(basename "$PROJECT_DIR")"
if [ -z "$PROJECT_NAME" ] || [ "$PROJECT_NAME" = "/" ]; then
  PROJECT_NAME="workspace"
fi

VM_NAME="${AI_VM_NAME:-${AGY_VM_NAME:-ai-vm}}"
CPUS="${AI_VM_CPUS:-${AGY_VM_CPUS:-4}}"
MEM="${AI_VM_MEM:-${AGY_VM_MEM:-8G}}"
DISK="${AI_VM_DISK:-${AGY_VM_DISK:-40G}}"
IMAGE="${AI_VM_IMAGE:-${AGY_VM_IMAGE:-24.04}}"

run_with_timeout() {
  local secs="$1"
  shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "$secs" "$@"
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$secs" "$@"
  else
    "$@" &
    local cmd_pid=$!
    (
      trap 'kill "${sleep_pid:-}" 2>/dev/null || true; exit 0' TERM
      sleep "$secs" &
      sleep_pid=$!
      wait "$sleep_pid" 2>/dev/null || exit 0
      kill -TERM "$cmd_pid" 2>/dev/null || true
      sleep 2
      kill -KILL "$cmd_pid" 2>/dev/null || true
    ) >/dev/null 2>&1 &
    local timer_pid=$!
    local rc=0
    wait "$cmd_pid" || rc=$?
    kill "$timer_pid" 2>/dev/null || true
    wait "$timer_pid" 2>/dev/null || true
    return "$rc"
  fi
}

run_mp_timeout() {
  local secs="$1"
  shift
  run_with_timeout "$secs" multipass "$@" </dev/null
}

vm_exists() {
  local csv
  if ! csv="$(run_mp_timeout 10 list --format csv 2>/dev/null)"; then
    sleep 2
    csv="$(run_mp_timeout 10 list --format csv 2>/dev/null)" || return 2
  fi
  printf '%s\n' "$csv" | awk -F',' -v name="$VM_NAME" '$1 == name {found=1} END {exit !found}'
}

vm_status() {
  local csv status
  csv="$(run_mp_timeout 10 list --format csv 2>/dev/null || true)"
  status="$(printf '%s\n' "$csv" | awk -F',' -v name="$VM_NAME" '$1 == name {print $2; exit}')"
  printf '%s\n' "${status:-Unknown}"
}

vm_is_responsive() {
  run_mp_timeout 5 exec "$VM_NAME" -- true >/dev/null 2>&1
}

wait_for_vm_responsive() {
  local timeout_secs="$1"
  local deadline=$((SECONDS + timeout_secs))
  while true; do
    if vm_is_responsive; then
      return 0
    fi
    if [ "$SECONDS" -ge "$deadline" ]; then
      return 1
    fi
    sleep 2
  done
}

force_restart_vm() {
  run_mp_timeout 30 stop --force "$VM_NAME" >/dev/null 2>&1 || true
  sleep 2
  run_mp_timeout 90 start --timeout 60 "$VM_NAME" || true
}

ensure_vm_running() {
  local status
  status="$(vm_status)"

  if [ "$status" = "Deleted" ]; then
    echo "VM '$VM_NAME' is in Deleted state; recovering..."
    run_mp_timeout 30 recover "$VM_NAME" || true
    status="$(vm_status)"
  fi

  if [ "$status" = "Delayed Shutdown" ]; then
    echo "VM '$VM_NAME' has a pending shutdown; cancelling..."
    run_mp_timeout 10 stop --cancel "$VM_NAME" >/dev/null 2>&1 || true
    status="$(vm_status)"
  fi

  # Fast path if already running and responsive (with short grace wait if finishing boot)
  if [ "$status" = "Running" ] && vm_is_responsive; then
    return 0
  fi

  if [ "$status" = "Running" ] || [ "$status" = "Starting" ] || [ "$status" = "Restarting" ]; then
    echo "Checking if '$VM_NAME' (state: $status) becomes responsive..."
    if wait_for_vm_responsive 10; then
      return 0
    fi
    status="$(vm_status)"
  fi

  local max_attempts=3
  local attempt
  for attempt in $(seq 1 "$max_attempts"); do
    if [ "$attempt" -eq 1 ]; then
      case "$status" in
        Stopped|Suspended)
          echo "Starting VM '$VM_NAME' (state: $status, attempt $attempt/$max_attempts)..."
          if ! run_mp_timeout 90 start --timeout 60 "$VM_NAME"; then
            echo "Start failed for '$VM_NAME'; force-stopping to discard stale state and retrying start..." >&2
            force_restart_vm
          fi
          ;;
        Running)
          echo "VM '$VM_NAME' is Running but unresponsive; restarting (attempt $attempt/$max_attempts)..." >&2
          if ! run_mp_timeout 25 restart --timeout 20 "$VM_NAME"; then
            echo "Restart failed or timed out for '$VM_NAME'; force-stopping and starting..." >&2
            force_restart_vm
          fi
          ;;
        *)
          echo "VM '$VM_NAME' is in state '$status'; force-stopping and starting (attempt $attempt/$max_attempts)..." >&2
          force_restart_vm
          ;;
      esac
    else
      echo "Recovering VM '$VM_NAME' via force-stop and start (attempt $attempt/$max_attempts)..." >&2
      force_restart_vm
    fi

    echo "Waiting for '$VM_NAME' to become responsive..."
    if wait_for_vm_responsive 45; then
      return 0
    fi

    status="$(vm_status)"
  done

  echo "Error: '$VM_NAME' failed to become responsive after $max_attempts recovery attempts (last state: $status)." >&2
  exit 1
}

mount_is_healthy() {
  local target="$1"
  run_mp_timeout 10 exec "$VM_NAME" -- bash -c "cd '$target' && ls >/dev/null" >/dev/null 2>&1
}

ensure_project_mounted() {
  local mount_target=""
  local info_json=""
  local info_text=""

  if command -v jq >/dev/null 2>&1; then
    info_json="$(run_mp_timeout 10 info "$VM_NAME" --format json 2>/dev/null || true)"
    if [ -n "$info_json" ]; then
      mount_target="$(printf '%s\n' "$info_json" | jq -r --arg vm "$VM_NAME" --arg src "$PROJECT_DIR" '.info[$vm]?.mounts // {} | to_entries[]? | select(.value.source_path == $src) | .key' 2>/dev/null | head -n 1 || true)"
    fi
  else
    info_text="$(run_mp_timeout 10 info "$VM_NAME" 2>/dev/null || true)"
    if [ -n "$info_text" ]; then
      mount_target="$(printf '%s\n' "$info_text" | awk -v src="$PROJECT_DIR" '($1 == src && $2 == "=>") {print $3; exit} ($1 == "Mounts:" && $2 == src && $3 == "=>") {print $4; exit}' || true)"
    fi
  fi

  if [ -n "$mount_target" ]; then
    TARGET_DIR="$mount_target"
    if mount_is_healthy "$TARGET_DIR"; then
      return 0
    fi
    echo "Existing mount '$VM_NAME:$TARGET_DIR' is stale or unreadable; remounting..." >&2
    run_mp_timeout 15 umount "$VM_NAME:$TARGET_DIR" >/dev/null 2>&1 || true
  else
    TARGET_DIR="/home/ubuntu/$PROJECT_NAME"
    local has_collision=0
    if command -v jq >/dev/null 2>&1; then
      if [ -n "$info_json" ] && [ -n "$(printf '%s\n' "$info_json" | jq -r --arg vm "$VM_NAME" --arg tgt "$TARGET_DIR" '.info[$vm]?.mounts[$tgt]?.source_path // empty' 2>/dev/null || true)" ]; then
        has_collision=1
      fi
    elif [ -n "$info_text" ] && printf '%s\n' "$info_text" | grep -F " => $TARGET_DIR" >/dev/null 2>&1; then
      has_collision=1
    fi
    if [ "$has_collision" -eq 1 ]; then
      local parent_dir
      parent_dir="$(basename "$(dirname "$PROJECT_DIR")")"
      TARGET_DIR="/home/ubuntu/${parent_dir}-${PROJECT_NAME}"
    fi
  fi

  local max_mount_attempts=3
  local attempt
  for attempt in $(seq 1 "$max_mount_attempts"); do
    echo "Mounting '$PROJECT_DIR' -> '$VM_NAME:$TARGET_DIR' (attempt $attempt/$max_mount_attempts)..."
    if [ "$attempt" -gt 1 ]; then
      run_mp_timeout 15 umount "$VM_NAME:$TARGET_DIR" >/dev/null 2>&1 || true
      sleep 2
    fi
    if run_mp_timeout 10 exec "$VM_NAME" -- mkdir -p "$TARGET_DIR" && \
       run_mp_timeout 30 mount "$PROJECT_DIR" "$VM_NAME:$TARGET_DIR" && \
       mount_is_healthy "$TARGET_DIR"; then
      return 0
    fi
    echo "Mount attempt $attempt/$max_mount_attempts failed for '$VM_NAME:$TARGET_DIR'." >&2
  done

  echo "Error: Failed to mount '$PROJECT_DIR' into '$VM_NAME:$TARGET_DIR' after $max_mount_attempts attempts." >&2
  exit 1
}

run_mp_timeout 15 wait-ready >/dev/null 2>&1 || true

EXISTS_RC=0
vm_exists || EXISTS_RC=$?
if [ "$EXISTS_RC" -eq 2 ]; then
  echo "Error: Failed to query Multipass instances (multipassd may be unavailable)." >&2
  exit 1
elif [ "$EXISTS_RC" -eq 1 ]; then
  echo "Creating VM '$VM_NAME' (${CPUS} CPUs, ${MEM} RAM, ${DISK} Disk)..."
  echo "Launching instance..."

  cat << 'EOF' | multipass launch "$IMAGE" \
    --name "$VM_NAME" \
    --cpus "$CPUS" \
    --memory "$MEM" \
    --disk "$DISK" \
    --cloud-init -
#cloud-config
package_update: true
packages:
  # Base system and utilities
  - apt-transport-https
  - ca-certificates
  - curl
  - wget
  - gnupg
  - lsb-release
  - software-properties-common
  # Build tools and compilers
  - build-essential
  - gcc
  - g++
  - clang
  - llvm
  - make
  - cmake
  - ninja-build
  - pkg-config
  - autoconf
  - automake
  - libtool
  - gdb
  - valgrind
  - strace
  - lsof
  # Header libraries (enables native compiling of Python/Ruby/Node extensions)
  - libssl-dev
  - zlib1g-dev
  - libbz2-dev
  - libreadline-dev
  - libsqlite3-dev
  - libffi-dev
  - libncurses5-dev
  - libgdbm-dev
  - liblzma-dev
  - libyaml-dev
  # CLI search, processing and text tools
  - git
  - gh
  - ripgrep
  - fd-find
  - fzf
  - bat
  - jq
  - yq
  - tree
  - htop
  - tmux
  - unzip
  - zip
  - p7zip-full
  - tar
  - gzip
  - bzip2
  - xz-utils
  - zstd
  - file
  - patch
  - shellcheck
  - shfmt
  # Networking & HTTP testing
  - httpie
  - netcat-openbsd
  - socat
  - dnsutils
  - iputils-ping
  - traceroute
  # Languages & Runtimes
  - python3
  - python3-pip
  - python3-venv
  - python3-dev
  - pipx
  - ruby-full
  - ruby-dev
  - bundler
  - golang-go
  - openjdk-21-jdk-headless
  - maven
  - gradle
  - php-cli
  - php-curl
  - php-mbstring
  - php-xml
  - php-zip
  - composer
  # Database & cache clients
  - sqlite3
  - postgresql-client
  - default-mysql-client
  - redis-tools
  # Containers
  - docker.io
  - docker-compose-v2
  - docker-buildx

groups:
  - docker

system_info:
  default_user:
    groups: [docker, sudo]

write_files:
  - path: /etc/profile.d/99-ai-vm.sh
    permissions: '0644'
    owner: root:root
    content: |
      export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$HOME/.bun/bin:$HOME/go/bin:/usr/local/go/bin:$HOME/.rbenv/bin:$HOME/.rbenv/shims:$PATH"
      export GOPATH="$HOME/go"

      if [ -d "$HOME/.rbenv" ]; then
        eval "$(rbenv init - bash 2>/dev/null || true)"
      fi

      if command -v mise >/dev/null 2>&1; then
        eval "$(mise activate bash 2>/dev/null || true)"
      fi

      if command -v fnm >/dev/null 2>&1; then
        eval "$(fnm env --use-on-cd 2>/dev/null || true)"
      fi

  - path: /usr/local/bin/provision-ai-vm.sh
    permissions: '0755'
    owner: root:root
    content: |
      #!/usr/bin/env bash
      set -euxo pipefail

      # 1. Docker daemon configuration & user access
      usermod -aG docker ubuntu
      systemctl enable --now docker

      # 2. Package command aliases (Ubuntu package naming aliases)
      if command -v fdfind >/dev/null 2>&1; then
        ln -sf "$(command -v fdfind)" /usr/local/bin/fd
      fi
      if command -v batcat >/dev/null 2>&1; then
        ln -sf "$(command -v batcat)" /usr/local/bin/bat
      fi

      # 3. HashiCorp Terraform
      install -m 0755 -d /usr/share/keyrings
      wget -O- https://apt.releases.hashicorp.com/gpg | gpg --dearmor --yes -o /usr/share/keyrings/hashicorp-archive-keyring.gpg
      echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" | tee /etc/apt/sources.list.d/hashicorp.list
      apt-get update -y
      apt-get install -y terraform

      # 4. tenv (Terraform / OpenTofu / Terragrunt version manager)
      ARCH="$(dpkg --print-architecture)"
      TENV_DEB_URL="$(curl -fsSL https://api.github.com/repos/tofuutils/tenv/releases/latest | grep -o "https://github.com/tofuutils/tenv/releases/download/[^\"]*_${ARCH}.deb" | head -n 1 || true)"
      if [ -n "$TENV_DEB_URL" ]; then
        curl -fsSL -o /tmp/tenv.deb "$TENV_DEB_URL"
        dpkg -i /tmp/tenv.deb || true
        rm -f /tmp/tenv.deb
      fi

      # 5. Kubernetes CLI (kubectl)
      KUBECTL_ARCH="$ARCH"
      curl -fsSL "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/${KUBECTL_ARCH}/kubectl" -o /usr/local/bin/kubectl || true
      chmod +x /usr/local/bin/kubectl || true

      # 6. Node.js 22 LTS + npm + Corepack (yarn & pnpm) + common TS tools
      curl -fsSL https://deb.nodesource.com/setup_22.x | bash -
      apt-get install -y nodejs
      corepack enable || true
      npm install -g yarn pnpm typescript tsx ts-node prettier eslint || true

      # 7. Fast Node Manager (fnm)
      curl -fsSL https://fnm.vercel.app/install | bash -s -- --install-dir /usr/local/bin --skip-shell || true

      # 8. Astral uv (Ultra-fast Python package & version manager) + core Python tools
      curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh || true
      su - ubuntu -c "uv tool install ruff || true"
      su - ubuntu -c "uv tool install pytest || true"
      su - ubuntu -c "uv tool install mypy || true"
      su - ubuntu -c "uv tool install black || true"

      # 9. Rust toolchain (rustup & cargo)
      su - ubuntu -c "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable" || true
      if [ -d "/home/ubuntu/.cargo/bin" ]; then
        for bin in /home/ubuntu/.cargo/bin/*; do
          if [ -f "$bin" ]; then
            ln -sf "$bin" "/usr/local/bin/$(basename "$bin")" || true
          fi
        done
      fi

      # 10. Bun runtime & package manager
      su - ubuntu -c "curl -fsSL https://bun.sh/install | bash" || true
      if [ -f /home/ubuntu/.bun/bin/bun ]; then
        ln -sf /home/ubuntu/.bun/bin/bun /usr/local/bin/bun
      fi

      # 11. Deno runtime
      curl -fsSL https://deno.land/install.sh | env DENO_INSTALL=/usr/local sh || true

      # 12. mise (Universal runtime version manager)
      curl -fsSL https://mise.run | env MISE_INSTALL_PATH=/usr/local/bin/mise sh || true

      # 13. rbenv & ruby-build
      if [ ! -d "/home/ubuntu/.rbenv" ]; then
        su - ubuntu -c "git clone --depth 1 https://github.com/rbenv/rbenv.git ~/.rbenv"
        su - ubuntu -c "git clone --depth 1 https://github.com/rbenv/ruby-build.git ~/.rbenv/plugins/ruby-build"
      fi

      # 14. Antigravity CLI (agy)
      su - ubuntu -c "curl -fsSL https://antigravity.google/cli/install.sh | bash" || true
      if [ -f /home/ubuntu/.local/bin/agy ]; then
        ln -sf /home/ubuntu/.local/bin/agy /usr/local/bin/agy
      fi

      # 15. Ensure environment source in user bashrc
      PROFILE_LINE="[ -f /etc/profile.d/99-ai-vm.sh ] && source /etc/profile.d/99-ai-vm.sh"
      if ! grep -qxF "$PROFILE_LINE" /home/ubuntu/.bashrc 2>/dev/null; then
        echo "$PROFILE_LINE" >> /home/ubuntu/.bashrc
      fi

runcmd:
  - /usr/local/bin/provision-ai-vm.sh
EOF

  echo "Waiting for provisioning to complete..."
  multipass exec "$VM_NAME" -- cloud-init status --wait </dev/null || true
  echo "VM '$VM_NAME' ready."
fi

ensure_vm_running
ensure_project_mounted

echo "Entering '$VM_NAME' in '$TARGET_DIR'..."
exec multipass exec "$VM_NAME" -- bash -c "cd '$TARGET_DIR' && exec bash -l"
